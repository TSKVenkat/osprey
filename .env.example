# --- API ---
NODE_ENV=development
PORT=3000
# Comma-separated list of origins allowed to call the API.
WEB_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgres://bilby:bilby@localhost:5432/bilby

# --- Secrets ---
# 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts storage credentials at rest. Changing it makes existing credentials unreadable.
SECRET_KEY=

# --- First admin (used once, on an empty database) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- Local storage backend (development default) ---
STORAGE_LOCAL_ROOT=./data/storage

# --- MinIO (docker compose) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bilby
S3_ACCESS_KEY_ID=bilby
S3_SECRET_ACCESS_KEY=bilby123

# How a BROWSER reaches this instance. Playback URLs are built from it, so a value
# that is right for one topology and wrong for another produces recordings that
# upload fine and then refuse to play.
#   running from source:  http://localhost:3000   (the API directly)
#   docker compose:       http://localhost:8080   (everything behind the web container)
PUBLIC_API_URL=http://localhost:3000

# Days a deleted recording keeps its files before the sweeper removes them.
RETENTION_DAYS=7

# --- Cloudinary (optional storage backend) ---
# Configured through Settings in the app, not read from here. These are only used
# by the conformance suite: set them to run it against a real account.
# CLOUDINARY_TEST_CLOUD_NAME=
# CLOUDINARY_TEST_API_KEY=
# CLOUDINARY_TEST_API_SECRET=

# --- ImageKit (optional storage backend) ---
# IMAGEKIT_TEST_URL_ENDPOINT=https://ik.imagekit.io/your-id
# IMAGEKIT_TEST_PUBLIC_KEY=
# IMAGEKIT_TEST_PRIVATE_KEY=
