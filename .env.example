# --- API ---
NODE_ENV=development
PORT=3000
# Comma-separated list of origins allowed to call the API.
WEB_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL=postgres://openloom:openloom@localhost:5432/openloom

# --- Secrets ---
# 32 bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Encrypts storage credentials at rest. Changing it makes existing credentials unreadable.
SECRET_KEY=

# --- First admin (used once, on an empty database) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please

# --- Local storage backend (development default) ---
STORAGE_LOCAL_ROOT=./data/storage

# --- MinIO (docker compose) ---
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=openloom
S3_ACCESS_KEY_ID=openloom
S3_SECRET_ACCESS_KEY=openloom123

# Public base URL of the API, used to build local file URLs.
PUBLIC_API_URL=http://localhost:3000
