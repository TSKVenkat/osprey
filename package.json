{
  "name": "openloom-core",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Screen recording and share links, self-hosted, with pluggable storage. No AI features.",
  "repository": { "type": "git", "url": "https://github.com/TSKVenkat/openloom-core.git" },
  "homepage": "https://github.com/TSKVenkat/openloom-core#readme",
  "bugs": "https://github.com/TSKVenkat/openloom-core/issues",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "db:generate": "pnpm --filter @openloom/db generate",
    "db:migrate": "pnpm --filter @openloom/db migrate",
    "dev:api": "pnpm --filter @openloom/api dev",
    "dev:web": "pnpm --filter @openloom/web dev",
    "build": "pnpm -r --if-present build",
    "test:e2e": "playwright test",
    "dev:worker": "pnpm --filter @openloom/worker dev",
    "stack": "docker compose --env-file .env -f deploy/docker-compose.yml up -d --build",
    "stack:down": "docker compose --env-file .env -f deploy/docker-compose.yml down",
    "stack:deps": "docker compose --env-file .env -f deploy/docker-compose.yml up -d postgres minio minio-setup",
    "stack:logs": "docker compose --env-file .env -f deploy/docker-compose.yml logs -f api worker"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
